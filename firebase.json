{
  "hosting": {
    "public": "dist",
    "predeploy": ["node scripts/firebase-guard.mjs --hook"],
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**/!(*.*)", "destination": "/index.html" }],
    "headers": [
      {
        "source": "**/*.@(js|mjs|css|map)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "**/*.@(png|ico|svg|webp|woff2)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
      },
      {
        "source": "/@(index.html|sw.js|manifest.webmanifest)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/!(*.*)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "predeploy": ["node scripts/firebase-guard.mjs --hook"]
  },
  "storage": {
    "rules": "storage.rules",
    "predeploy": ["node scripts/firebase-guard.mjs --hook"]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "predeploy": ["node scripts/firebase-guard.mjs --hook", "npm --prefix functions run build"],
    "ignore": ["node_modules", ".git", "src", "test", "*.log"]
  },
  "emulators": {
    "singleProjectMode": true,
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "functions": { "port": 5001 },
    "storage": { "port": 9199 },
    "ui": { "enabled": true, "port": 4000 }
  }
}
