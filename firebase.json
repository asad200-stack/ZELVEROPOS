{
  "hosting": [
    {
      "target": "production",
      "public": "dist",
      "predeploy": [
        "node scripts/firebase-guard.mjs --hook"
      ],
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/app/0.9.1-admin.1",
          "destination": "/app/0.9.1-admin.1/index.html"
        },
        {
          "source": "/app/0.9.1-admin.1/**",
          "destination": "/app/0.9.1-admin.1/index.html"
        },
        {
          "source": "/app/0.9.2-ai.1",
          "destination": "/app/0.9.2-ai.1/index.html"
        },
        {
          "source": "/app/0.9.2-ai.1/**",
          "destination": "/app/0.9.2-ai.1/index.html"
        },
        {
          "source": "**/!(*.*)",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**/*.@(js|mjs|css|map)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/app/0.9.1-admin.1/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/app/0.9.2-ai.1/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/*.@(png|ico|svg|webp|woff2)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=604800"
            }
          ]
        },
        {
          "source": "/@(index.html|sw.js|boot.js|manifest.webmanifest)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/app/0.9.1-admin.1/@(index.html|sw.js|boot.js|manifest.webmanifest)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/app/0.9.2-ai.1/@(index.html|sw.js|boot.js|manifest.webmanifest|open.html|open.js)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/!(*.*)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(self), geolocation=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=(), browsing-topics=()"
            },
            {
              "key": "Strict-Transport-Security",
              "value": "max-age=15552000; includeSubDomains"
            },
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self' 'wasm-unsafe-eval' https://apis.google.com https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/ https://www.recaptcha.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.googleapis.com https://*.gstatic.com https://*.google.com https://*.firebasestorage.app https://firebasestorage.googleapis.com https://storage.googleapis.com https://picsum.photos https://fastly.picsum.photos; font-src 'self'; connect-src 'self' https://*.googleapis.com https://*.google.com https://*.gstatic.com https://*.firebaseio.com wss://*.firebaseio.com https://*.cloudfunctions.net https://*.run.app https://*.firebasestorage.app https://firebasestorage.googleapis.com https://www.recaptcha.net https://huggingface.co https://cdn-lfs.huggingface.co https://cas-bridge.xethub.hf.co https://*.hf.co https://cdn.jsdelivr.net; frame-src https://www.google.com https://www.recaptcha.net https://*.firebaseapp.com https://*.google.com; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
            }
          ]
        }
      ]
    },
    {
      "target": "staging",
      "public": "release-dist",
      "predeploy": [
        "node scripts/firebase-guard.mjs --hook"
      ],
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/app/0.9.0-dev/**",
          "destination": "/app/0.9.0-dev/index.html"
        },
        {
          "source": "/app/0.9.1-preview.1/**",
          "destination": "/app/0.9.1-preview.1/index.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/app/**/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/@(index.html|boot.js|release.json)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/app/**/@(index.html|sw.js|manifest.webmanifest)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Strict-Transport-Security",
              "value": "max-age=15552000; includeSubDomains"
            }
          ]
        }
      ]
    },
    {
      "target": "web-staging",
      "public": "apps/marketing/staging-dist",
      "predeploy": [
        "node scripts/firebase-guard.mjs --hook"
      ],
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://*.cloudfunctions.net https://*.run.app https://*.googleapis.com; worker-src 'self'; upgrade-insecure-requests"
            }
          ]
        }
      ]
    },
    {
      "target": "marketing",
      "public": "apps/marketing/dist",
      "predeploy": [
        "node scripts/firebase-guard.mjs --hook"
      ],
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://*.cloudfunctions.net https://*.run.app https://*.googleapis.com; worker-src 'self'; upgrade-insecure-requests"
            }
          ]
        }
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "predeploy": [
      "node scripts/firebase-guard.mjs --hook"
    ]
  },
  "storage": {
    "rules": "storage.rules",
    "predeploy": [
      "node scripts/firebase-guard.mjs --hook"
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "predeploy": [
      "node scripts/firebase-guard.mjs --hook",
      "npm --prefix functions run build"
    ],
    "ignore": [
      "node_modules",
      ".git",
      "src",
      "test",
      "*.log"
    ]
  },
  "emulators": {
    "singleProjectMode": true,
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "pubsub": {
      "port": 8086
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  }
}
