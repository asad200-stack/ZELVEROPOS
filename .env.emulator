# Local Firebase Emulator Suite only (`npm run dev:emulators`). Contains no real credentials:
# "demo-*" projects can never reach a real Firebase project.
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-zelvero
VITE_EXPECTED_FIREBASE_PROJECT_ID=demo-zelvero
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-zelvero.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=demo-zelvero.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_FIREBASE_FUNCTIONS_REGION=europe-west1
VITE_SUPPORT_PHONE=+96171783701
