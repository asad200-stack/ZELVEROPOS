# ZELVERO POS - frontend configuration.
# Copy to .env.local for development and .env.production for production builds.
# These are PUBLIC web-app identifiers (not secrets), but they decide which Firebase
# project the app talks to. NEVER put the old CATCH POS project values here:
# the dev server, the build and every deploy refuse to run if you do.

# Firebase web app config (Firebase console > Project settings > Your apps > Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Safety net: must equal VITE_FIREBASE_PROJECT_ID and the .firebaserc default project.
VITE_EXPECTED_FIREBASE_PROJECT_ID=

# Cloud Functions region (must match functions/src/config.ts REGION)
VITE_FIREBASE_FUNCTIONS_REGION=us-central1

# Optional App Check (reCAPTCHA Enterprise site key). Leave empty to disable.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Local development against the Firebase Emulator Suite (no real project is touched).
# When true, VITE_FIREBASE_PROJECT_ID must start with "demo-" (for example demo-zelvero).
VITE_USE_FIREBASE_EMULATORS=false

# Support contact shown to users (WhatsApp/phone, international format)
VITE_SUPPORT_PHONE=+96171783701