# Cloud Functions parameters (copy to functions/.env.<your-new-project-id>; never commit real values).
# The Firebase CLI also prompts for missing values on first deploy.

# Comma-separated e-mails allowed to claim the platform super admin role (Setup screen button).
SUPER_ADMIN_EMAILS=you@example.com

# Free trial days for new stores (0 = the super admin activates each store manually).
SIGNUP_TRIAL_DAYS=0

# IANA time zone used for dates in Telegram notifications.
TELEGRAM_TIMEZONE=Asia/Beirut
